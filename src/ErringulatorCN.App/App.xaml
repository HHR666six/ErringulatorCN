<Application x:Class="ErringulatorCN.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ============ 设计令牌 ============ -->
        <Color x:Key="Col.Accent">#6C5CE7</Color>
        <Color x:Key="Col.AccentHover">#8B7BF5</Color>
        <Color x:Key="Col.AccentDark">#5849C4</Color>
        <Color x:Key="Col.Window">#F3F4F8</Color>
        <Color x:Key="Col.Card">#FFFFFF</Color>
        <Color x:Key="Col.Border">#E1E3EC</Color>
        <Color x:Key="Col.Text">#2B2F3A</Color>
        <Color x:Key="Col.TextDim">#6B7280</Color>
        <Color x:Key="Col.TextFaint">#9CA3AF</Color>
        <Color x:Key="Col.Success">#16A34A</Color>

        <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Col.Accent}"/>
        <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Col.AccentHover}"/>
        <SolidColorBrush x:Key="Brush.AccentDark" Color="{StaticResource Col.AccentDark}"/>
        <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Col.Window}"/>
        <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Col.Card}"/>
        <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Col.Border}"/>
        <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Col.Text}"/>
        <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Col.TextDim}"/>
        <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Col.TextFaint}"/>
        <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Col.Success}"/>

        <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
        <FontFamily x:Key="Font.Mono">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

        <!-- ============ 全局文本 ============ -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============ 分区卡片 ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 卡片标题：色条 + 文字 -->
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ============ 复选框 / 单选 ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 子选项：缩进 + 略淡，表明从属于上方父项 -->
        <Style x:Key="SubOption" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="14,2,16,2"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        </Style>

        <!-- ============ 输入框：细边圆角，聚焦高亮 ============ -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F7"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 按钮：普通 / 主按钮 ============ -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F1F8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6E8F4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}"/>
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（开始随机化）-->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Brush.Accent}"
                                BorderBrush="{StaticResource Brush.AccentDark}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#DDDDE4"/>
                                <Setter TargetName="bd" Property="Background" Value="#B9B4DC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B9B4DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 进度条：主题色细条 ============ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Background" Value="#E5E7F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" HorizontalAlignment="Left" ClipToBounds="True"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Expander：召唤物面板（去默认样式，卡片化）============ -->
        <Style TargetType="Expander">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Cursor="Hand"
                                          Content="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="▸" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="▾"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="PART_Content" Visibility="Collapsed" Margin="4,4,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="PART_Content" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox：圆角统一 ============ -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

    </Application.Resources>
</Application>
